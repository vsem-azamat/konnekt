---
/** One guide, with links to its translations. */
import { type CollectionEntry, getCollection, render } from 'astro:content';

import Base from '../layouts/Base.astro';
import { langOf, slugOf } from '../paths.ts';
import { TEXTS } from '../texts.ts';

interface Props {
  guide: CollectionEntry<'guides'>;
}

const { guide } = Astro.props;
const lang = langOf(guide.id);
const slug = slugOf(guide.id);
const langs = (await getCollection('guides'))
  .filter((other) => slugOf(other.id) === slug)
  .map((other) => langOf(other.id));
const { Content } = await render(guide);
---

<Base
  lang={lang}
  path={`/guides/${slug}/`}
  langs={langs}
  title={`${guide.data.title} — Konnekt`}
  description={guide.data.description}
  noindex={guide.data.draft}
>
  <main class="page">
    {guide.data.draft && <span class="badge">{TEXTS[lang].example}</span>}
    <article class="article">
      <h1>{guide.data.title}</h1>
      <Content />
    </article>
  </main>
</Base>
