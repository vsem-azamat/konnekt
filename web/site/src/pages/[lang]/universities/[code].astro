---
import { universityPage } from '../../../catalog/directoryPages.ts';
import { CACHED } from '../../../catalog/page.ts';
/** Rendered on request (catalog/directoryPages.ts): see the component for what it shows. */
import University from '../../../catalog/University.astro';

export const prerender = false;

const page = await universityPage(Astro.params.lang, Astro.params.code);
if (page instanceof Response) return page;
Astro.response.headers.set('Cache-Control', CACHED);
---

<University {...page} />
