{
	servers {
		# The edge proxy in front reaches this one over a private address; its
		# X-Forwarded-For is passed on rather than replaced with its own.
		trusted_proxies static private_ranges
		# Read from the right: a client cannot pick its own address by
		# sending one first.
		trusted_proxies_strict
	}
	# Caddy's own log, errors included. Spelled out: a snippet cannot be
	# imported here, the global block being first; keep it the same as below.
	log {
		output stderr
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				request>tls delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				resp_headers delete
			}
		}
	}
}

# What a log line leaves out, in the access log and in Caddy's own error log
# alike: a proxy error carries the request it failed on, and a sign-in
# callback's `code` and `state` ride in its query string, a path names the
# person it is about (/api/audience/<id>), and the browser sends cookies and an
# Authorization header with initData. None of it belongs in a log. The line
# keeps what happened to the request: its method, host, status, time, an id,
# and which backend (`handler`) it went to; the backend's own line, found by the
# id, has the route.
(without_the_request) {
	format filter {
		wrap json
		fields {
			request>uri delete
			request>headers delete
			request>tls delete
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			resp_headers delete
		}
	}
}

(access_log) {
	log {
		output stdout
		import without_the_request
	}
	# One id per request, here, so the line below and the backends' lines agree.
	log_append request_id {http.request.uuid}
	# The container check, every few seconds, and files nobody reads a line about.
	@quiet path /healthz /assets/*
	log_skip @quiet
}

:80 {
	import access_log
	encode zstd gzip

	# On every response. The Mini App must stay framable by Telegram's web
	# clients, so framing is limited with frame-ancestors, never refused with
	# X-Frame-Options; anybody else framing the console is the clickjacking
	# this stops. HSTS reaches browsers through the TLS edge in front.
	header {
		Content-Security-Policy "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
	}

	# The catalog's API (catalog/), for the Mini App's help screens: tutors,
	# profiles, requests. First, so the /api/* block below never sees it.
	#
	# Cookies stop here, both ways. The console's session cookie is valid on
	# this whole origin, and the catalog authenticates by initData alone: it
	# has no use for an admin session, and no business setting cookies on it.
	#
	# The X-Catalog-* headers are how webapi signs an operator in from the
	# containers' own network (catalog/docs/architecture.md); from a browser
	# they are a guess at its token, so they never get through here.
	@catalog path /api/v1/* /healthz
	handle @catalog {
		log_append handler catalog
		reverse_proxy catalog-api:8000 {
			header_up X-Request-Id {http.request.uuid}
			header_up -Cookie
			header_up -X-Catalog-Service
			header_up -X-Catalog-Operator
			header_up -X-Catalog-Lang
			header_down -Set-Cookie
		}
	}

	# The browser's sign-in belongs to the console's host. Here the client
	# address is whatever Cloudflare shows, so the sign-in's rate limits would
	# count Cloudflare's and a loop of callbacks would reach Telegram with our
	# secret.
	@signIn path /api/auth/telegram/*
	handle @signIn {
		respond 404
	}

	# The catalog's console screens through webapi are for the console's own
	# host. Here the console is the Mini App's and asks the catalog itself,
	# with initData; a session cookie of this host never reaches them.
	@consoleCatalog path /api/catalog/*
	handle @consoleCatalog {
		respond 404
	}

	handle /api/* {
		log_append handler webapi
		reverse_proxy webapi:8787 {
			header_up X-Request-Id {http.request.uuid}
			# One address, the one this proxy believes, rather than the chain.
			header_up X-Forwarded-For {client_ip}
		}
	}

	# The old console's addresses, bookmarked or in old messages, lead to the
	# console inside the Mini App: a chat's page to the same chat, the lists
	# and the hierarchy (now the chat list grouped by parent) to the chats,
	# settings to the system screen, anything else to the summary. Permanent,
	# so browsers remember them: change them knowing that.
	@oldChat path_regexp oldChat ^/admin/chats/(-?[0-9]+)/?$
	handle @oldChat {
		redir * /console/chats/{re.oldChat.1} permanent
	}
	@oldChats path /admin/chats /admin/chats/* /admin/hierarchy /admin/hierarchy/* /admin/catalog /admin/catalog/*
	handle @oldChats {
		redir * /console/chats permanent
	}
	@oldSettings path /admin/settings /admin/settings/
	handle @oldSettings {
		redir * /console/system permanent
	}
	@oldConsole path /admin /admin/*
	handle @oldConsole {
		redir * /console permanent
	}

	# The Mini App owns every other path, its client-side routes included.
	# Hashed assets never change contents, so they are cached for good, but only
	# when they exist: a missing one is a 404, never the page and never cached.
	handle /assets/* {
		root * /srv/app
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# index.html is the one file that names the current hashes, so a cached
	# copy points at bundles the next deploy deleted.
	handle {
		root * /srv/app
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# The console opened in a browser (WEBAPI_ADMIN_URL's host), apart from the
# Mini App: its own origin means its own session cookie, which the Mini App's
# origin never receives. Only the console and the API behind it are served; the
# catalog's API and the public half are the Mini App's, and a path that is
# neither goes to the console rather than to the landing page.
#
# ADMIN_HOST is derived from WEBAPI_ADMIN_URL by the webui's command in
# docker-compose.yaml. Unset, it falls back to a name no request can carry, so
# the block is present and matches nothing.
http://{$ADMIN_HOST:admin.invalid} {
	import access_log
	encode zstd gzip

	# Never framed: the console is not opened inside Telegram from here.
	header {
		Content-Security-Policy "frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
	}

	@notOurs path /api/v1/* /api/public/* /api/internal/* /healthz
	handle @notOurs {
		respond 404
	}

	handle /api/* {
		log_append handler webapi
		reverse_proxy webapi:8787 {
			header_up X-Request-Id {http.request.uuid}
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /assets/* {
		root * /srv/app
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@console path /console /console/* /login
	handle @console {
		root * /srv/app
		header Cache-Control "no-cache"
		rewrite * /index.html
		file_server
	}

	handle {
		redir * /console 302
	}
}
