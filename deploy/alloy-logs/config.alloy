// Ships container logs of this host to Loki on the monitoring server.
//
// Only the Compose projects listed in the keep rule leave this machine
// (supervisor-telegram and gov-cz-bot); the other stacks on this host
// (khromberry, urf, ...) are not shipped. Each gets a `project` label, the one
// its metrics carry, so a dashboard filters logs and metrics alike. The lines
// are JSON, so `level` becomes a label and the request, update and chat ids
// stay inside the line, where a query reads them.

logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "containers" {
  host             = "tcp://socket-proxy:2375"
  refresh_interval = "30s"
}

discovery.relabel "shipped" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "supervisor-telegram|gov-cz-bot"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    target_label = "job"
    replacement  = "docker"
  }

  rule {
    target_label = "machine"
    replacement  = "azamat"
  }
}

loki.source.docker "containers" {
  host       = "tcp://socket-proxy:2375"
  targets    = discovery.relabel.shipped.output
  forward_to = [loki.process.json.receiver]
}

loki.process "json" {
  // A fresh start must not backfill what Docker still holds.
  stage.drop {
    older_than          = "24h"
    drop_counter_reason = "stale_docker_log"
  }

  // Lines that are not JSON (a startup banner, a library's last words) pass
  // through without a level.
  stage.json {
    expressions = {
      level = "level",
    }
  }

  stage.labels {
    values = {
      level = "",
    }
  }

  // Set here, not in discovery.relabel: the source keeps its read positions
  // per target label set, so a new target label would make it read every
  // container's log again from the start.
  stage.match {
    selector = "{compose_project=\"supervisor-telegram\"}"

    stage.static_labels {
      values = { project = "konnekt" }
    }
  }

  stage.match {
    selector = "{compose_project=\"gov-cz-bot\"}"

    stage.static_labels {
      values = { project = "gov-cz" }
    }
  }

  forward_to = [loki.write.monitoring.receiver]
}

loki.write "monitoring" {
  endpoint {
    url = "https://loki-push.azamat.io/loki/api/v1/push"

    basic_auth {
      username = sys.env("LOKI_PUSH_USER")
      password = sys.env("LOKI_PUSH_PASSWORD")
    }
  }
}
