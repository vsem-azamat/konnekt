---
/** Landing F's footer, on every page of the site. */
import { t as copy, OPEN } from '../landing/copy.ts';
import { type Lang, localePath } from '../paths.ts';

interface Props {
  lang: Lang;
  path?: string;
}

const { lang, path = '/' } = Astro.props;
const t = (key: string) => copy(lang, key);
const home = path === '/' ? '' : localePath(lang, '/');
---

<footer>
  <div class="wrap">
    <span class="logo"><svg viewBox="0 0 100 100" aria-hidden="true"><rect width="100" height="100" rx="26" fill="var(--tile-white)" stroke="var(--hair)" stroke-width="3"/><path d="M0 50H100V74Q100 100 74 100H26Q0 100 0 74Z" fill="#d7141a"/><path d="M0 26Q0 0 26 0H30L62 50 30 100H26Q0 100 0 74Z" fill="#11457e"/></svg>Konnekt</span>
    <span>{t("footer.tag")}</span>
    <nav class="links"><a href={localePath(lang, "/guides/")}>{t("nav.guides")}</a><a href={`${home}#offer`}>{t("footer.tutors")}</a><a href={OPEN}>{t("footer.contact")}</a><span>© 2026</span></nav>
  </div>
</footer>
