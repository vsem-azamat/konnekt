# Local development only.
#
# Production takes no .env: the deploy workflow forwards GitHub secrets and
# variables to the host with the deploy command, and nothing is written there.
# See docs/deployment/production-credentials.md.
#
# Copy to .env and fill in. Everything omitted falls back to the default in
# app/core/config.py; only MODERATOR_BOT_TOKEN, ADMIN_SUPER_ADMINS and the
# DB credentials have none.

# ── Moderator Bot ──
MODERATOR_BOT_TOKEN=your_bot_token_here
# The retired catalog bot (@student_cz_bot). Set, it answers every DM with the new address.
# MODERATOR_BOT_RETIRED_TOKEN=

# ── Admin ──
ADMIN_SUPER_ADMINS=123456789,987654321
ADMIN_REPORT_CHAT_ID=

# ── Database ──
DB_USER=postgres
DB_PASSWORD=your_password_here
# DB_HOST=db       # [Optional] default: db (docker service name)
# DB_PORT=5432     # [Optional]
DB_NAME=moderator_bot

# ── Application ──
APP_DEBUG=false
APP_ENVIRONMENT=development
APP_TIMEZONE=UTC

# ── Logging ──
LOG_LEVEL=INFO
# LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
# LOG_FILE_PATH=logs/bot.log
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5

# ── Ad detector (heuristic, no model) ──
MODERATION_AD_DETECTOR_ENABLED=true
MODERATION_AD_DETECTOR_WHITELIST=
MODERATION_AD_DETECTOR_SNIPPET_CHARS=200

# ── Telethon (Userbot) ──
TELETHON_API_ID=0
TELETHON_API_HASH=
# TELETHON_PHONE=+1234567890  # Required for first-time auth only

# ── Web admin UI ──
WEBAPI_PUBLIC_URL=http://localhost:5173
WEBAPI_MAGIC_LINK_TTL_MINUTES=15
WEBAPI_SESSION_TTL_DAYS=30
WEBAPI_SESSION_COOKIE_SECURE=false   # true in production (HTTPS)

# ── MCP control plane (served by the bot process) ──
# The token is the switch: unset means no endpoint.
MCP_TOKEN=
# Optional. Confirmations go to the first super admin unless this names another.
# MCP_INITIATOR_ID=0
