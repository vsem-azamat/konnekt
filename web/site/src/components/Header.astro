---
/**
 * Landing F's header on every page of the site: the logo, the sections of the
 * landing page, the languages (each its own address), the theme and the button
 * into the app. Between 720 and 1119px it keeps to one row (header.css): the
 * languages fold into «RU ▾», and below 960px the sections go behind «Меню».
 */
import { published } from '../articles/published.ts';
import { t as copy, OPEN } from '../landing/copy.ts';
import './header.css';
import { LANGS, type Lang, localePath, navSection, type Version } from '../paths.ts';

interface Props {
  lang: Lang;
  /** The page's path in Russian; a language link keeps it when the page exists in that language. */
  path?: string;
  langs?: readonly Lang[];
  /** For a page whose path differs between languages (an article): each version's own. */
  versions?: readonly Version[];
}

const { lang, path = '/', langs = LANGS, versions } = Astro.props;
const t = (key: string) => copy(lang, key);
// The articles' section, once this language has one to show.
const articles = (await published(lang)).length > 0;
// On the landing page the sections are anchors; elsewhere they lead back to it.
const home = path === '/' ? '' : localePath(lang, '/');
// The menu, the same in the row, under it and behind «Меню». An item whose
// section this page is in is marked; the landing's own sections, anchors,
// are marked by its script as they are scrolled to.
const section = navSection(path);
const items = [
  { href: `${home}#chats`, label: t('nav.chats'), section: 'chats' },
  { href: `${home}#tutors`, label: t('nav.tutors'), section: null },
  { href: `${home}#help`, label: t('nav.help'), section: null },
  { href: `${home}#how`, label: t('nav.how'), section: null },
  ...(articles
    ? [
        {
          href: localePath(lang, '/articles/'),
          label: t('nav.guides'),
          section: 'articles',
        },
      ]
    : []),
];
const localePathFor = (l: Lang) =>
  versions
    ? (versions.find((version) => version.lang === l)?.path ?? localePath(l, '/'))
    : localePath(l, langs.includes(l) ? path : '/');
---

<header class="top">
  <div class="wrap">
    <div class="bar">
      <a class="logo" href={localePath(lang, "/")} aria-label="Konnekt"><img src="/favicon.svg" alt="" /><span>Konnekt</span></a>
      <nav class="nav">{items.map((item) => <a href={item.href} aria-current={item.section !== null && item.section === section ? "page" : undefined}>{item.label}</a>)}</nav>
      <div class="tools">
        <details class="lang-dd"><summary aria-label={`${t("nav.language")}: ${lang.toUpperCase()}`}>{lang.toUpperCase()}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></summary><div class="lang-list">{LANGS.map((l) => <a href={localePathFor(l)} hreflang={l} lang={l} aria-current={l === lang ? "page" : undefined}><b>{l.toUpperCase()}</b>{copy(l, "lang.name")}</a>)}</div></details>
        <div class="langs">{LANGS.map((l) => <a href={localePathFor(l)} hreflang={l} lang={l} aria-current={l === lang ? "page" : undefined}>{l.toUpperCase()}</a>)}</div>
        <button class="icon-btn" data-theme-toggle aria-label={t("theme")}><svg class="sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg><svg class="moon" viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg></button>
        <a class="btn" href={OPEN}>{t("cta.open")}</a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu"><svg class="burger" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg><svg class="close" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg><span>{t("nav.menu")}</span></button>
      </div>
    </div>
    <nav class="menu-panel" id="site-menu" hidden>{items.map((item) => <a href={item.href} aria-current={item.section !== null && item.section === section ? "page" : undefined}>{item.label}</a>)}</nav>
    <nav class="subnav">{items.map((item) => <a href={item.href} aria-current={item.section !== null && item.section === section ? "page" : undefined}>{item.label}</a>)}</nav>
  </div>
</header>

<script>
  // «Меню» opens the sections' panel; a section, Esc or the button again closes it.
  for (const button of document.querySelectorAll<HTMLButtonElement>('.menu-btn')) {
    const panel = document.getElementById(button.getAttribute('aria-controls') ?? '');
    if (!panel) continue;
    const head = button.closest<HTMLElement>('.top');
    const set = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      // The anchor offset follows the header's height: update it now, before
      // the browser scrolls to a section, not when the observer gets to it.
      if (head) document.documentElement.style.setProperty('--head-h', `${head.offsetHeight}px`);
    };
    button.addEventListener('click', () => set(panel.hidden));
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || panel.hidden) return;
      // Focus inside the panel would be lost with it: back to the button.
      const inside = panel.contains(document.activeElement);
      set(false);
      if (inside) button.focus();
    });
  }
  // The language list closes on a click or focus outside it, and on Esc.
  const closeLists = (target: EventTarget | null) => {
    for (const list of document.querySelectorAll<HTMLDetailsElement>('.lang-dd[open]')) {
      if (!list.contains(target as Node)) list.open = false;
    }
  };
  document.addEventListener('click', (e) => closeLists(e.target));
  document.addEventListener('focusin', (e) => closeLists(e.target));
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    for (const list of document.querySelectorAll<HTMLDetailsElement>('.lang-dd[open]')) {
      list.open = false;
      list.querySelector('summary')?.focus();
    }
  });

  // The theme button: the same keys the page reads before its first paint.
  for (const button of document.querySelectorAll('[data-theme-toggle]')) {
    button.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('students-cz.theme', next);
      } catch {
        // No storage: the choice lasts for this page.
      }
    });
  }

  // Anchors land below the sticky header: its height feeds scroll-padding-top.
  const head = document.querySelector<HTMLElement>('.top');
  if (head) {
    const setHead = () =>
      document.documentElement.style.setProperty('--head-h', `${head.offsetHeight}px`);
    setHead();
    new ResizeObserver(setHead).observe(head);
  }
</script>
