---
/**
 * Every page of the site: its head for search engines and link previews, the
 * palette before the first paint, and the way back into the app for anyone
 * who reaches this page from inside Telegram.
 */
import '../../../src/styles/tokens.css';
import '../site.css';

import { getCollection } from 'astro:content';

import {
  alternates,
  hiddenPaths,
  indexedLangs,
  LANGS,
  type Lang,
  localePath,
  telegramHome,
} from '../paths.ts';
import { LANG_NAMES, OG_LOCALES, TEXTS } from '../texts.ts';

interface Props {
  lang: Lang;
  /** The page's path in Russian, from the root; each language adds its prefix. */
  path: string;
  /** The languages this page exists in. */
  langs?: readonly Lang[];
  title: string;
  description: string;
  /** For an example or an empty list: a page search engines must not keep. */
  noindex?: boolean;
}

const { lang, path, langs = LANGS, title, description, noindex = false } = Astro.props;
const site = Astro.site?.href ?? '/';
const canonical = new URL(localePath(lang, path), site).href;
const t = TEXTS[lang];
const hidden = hiddenPaths(
  (await getCollection('guides')).map(({ id, data }) => ({ id, draft: data.draft })),
);
const indexed = indexedLangs(path, langs, hidden);

// The tested function itself, not a copy of its logic: it has to run before the
// first paint, so inline, and it refers to nothing outside its arguments.
const handOff = `(() => {
  const to = (${telegramHome})(location.hash, location.search);
  if (to) location.replace(to);
})();`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fffefc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171614" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex &&
        alternates(path, indexed, site).map(({ hreflang, href }) => (
          <link rel="alternate" hreflang={hreflang} href={href} />
        ))
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Konnekt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALES[lang]} />
    <script is:inline set:html={handOff} />
    <script is:inline>
      // The palette before the first paint, the same keys and resolution as the
      // Mini App's index.html and src/lib/theme.ts: keep the three in step.
      (() => {
        let mode = null;
        try {
          mode = localStorage.getItem('students-cz.theme');
          if (mode !== 'light' && mode !== 'dark') mode = localStorage.getItem('konnekt.theme');
        } catch {}
        if (mode !== 'light' && mode !== 'dark') {
          mode = window.matchMedia?.('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = mode;
      })();
    </script>
  </head>
  <body>
    <header class="bar">
      <a class="wordmark" href={localePath(lang, '/')}>Konnekt</a>
      <nav class="nav">
        <a href={localePath(lang, '/guides/')}>{t.guides}</a>
        <details class="langs">
          <summary aria-label={t.language}>{lang.toUpperCase()}</summary>
          <ul>
            {
              LANGS.map((other) => (
                <li>
                  <a
                    href={localePath(other, langs.includes(other) ? path : '/')}
                    hreflang={other}
                    lang={other}
                    aria-current={other === lang ? 'true' : undefined}
                  >
                    {LANG_NAMES[other]}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </nav>
    </header>
    <slot />
  </body>
</html>
