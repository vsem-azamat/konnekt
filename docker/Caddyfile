{
	servers {
		# The edge proxy in front reaches this one over a private address; its
		# X-Forwarded-For is passed on rather than replaced with its own.
		trusted_proxies static private_ranges
		# Read from the right: a client cannot pick its own address by
		# sending one first.
		trusted_proxies_strict
	}
}

:80 {
	encode zstd gzip

	# On every response. The Mini App must stay framable by Telegram's web
	# clients, so framing is limited with frame-ancestors, never refused with
	# X-Frame-Options; anybody else framing the console is the clickjacking
	# this stops. HSTS reaches browsers through the TLS edge in front.
	header {
		Content-Security-Policy "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
	}

	# The catalog's API (catalog/), for the Mini App's help screens: tutors,
	# profiles, requests. First, so the /api/* block below never sees it.
	#
	# Cookies stop here, both ways. The console's session cookie is valid on
	# this whole origin, and the catalog authenticates by initData alone: it
	# has no use for an admin session, and no business setting cookies on it.
	@catalog path /api/v1/* /healthz
	handle @catalog {
		reverse_proxy catalog-api:8000 {
			header_up -Cookie
			header_down -Set-Cookie
		}
	}

	handle /api/* {
		reverse_proxy webapi:8787 {
			# One address, the one this proxy believes, rather than the chain.
			header_up X-Forwarded-For {client_ip}
		}
	}

	# The old console's addresses, bookmarked or in old messages, lead to the
	# console inside the Mini App: a chat's page to the same chat, the lists
	# and the hierarchy (now the chat list grouped by parent) to the chats,
	# settings to the system screen, anything else to the summary. Permanent,
	# so browsers remember them: change them knowing that.
	@oldChat path_regexp oldChat ^/admin/chats/(-?[0-9]+)/?$
	handle @oldChat {
		redir * /console/chats/{re.oldChat.1} permanent
	}
	@oldChats path /admin/chats /admin/chats/* /admin/hierarchy /admin/hierarchy/* /admin/catalog /admin/catalog/*
	handle @oldChats {
		redir * /console/chats permanent
	}
	@oldSettings path /admin/settings /admin/settings/
	handle @oldSettings {
		redir * /console/system permanent
	}
	@oldConsole path /admin /admin/*
	handle @oldConsole {
		redir * /console permanent
	}

	# The Mini App owns every other path, its client-side routes included.
	# Hashed assets never change contents, so they are cached for good, but only
	# when they exist: a missing one is a 404, never the page and never cached.
	handle /assets/* {
		root * /srv/app
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# index.html is the one file that names the current hashes, so a cached
	# copy points at bundles the next deploy deleted.
	handle {
		root * /srv/app
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# The console opened in a browser (WEBAPI_ADMIN_URL's host), apart from the
# Mini App: its own origin means its own session cookie, which the Mini App's
# origin never receives. Only the console and the API behind it are served; the
# catalog's API and the public half are the Mini App's, and a path that is
# neither goes to the console rather than to the landing page.
#
# ADMIN_HOST is derived from WEBAPI_ADMIN_URL by the webui's command in
# docker-compose.yaml. Unset, it falls back to a name no request can carry, so
# the block is present and matches nothing.
http://{$ADMIN_HOST:admin.invalid} {
	encode zstd gzip

	# Never framed: the console is not opened inside Telegram from here.
	header {
		Content-Security-Policy "frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
	}

	@notOurs path /api/v1/* /api/public/* /healthz
	handle @notOurs {
		respond 404
	}

	handle /api/* {
		reverse_proxy webapi:8787 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /assets/* {
		root * /srv/app
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@console path /console /console/* /login
	handle @console {
		root * /srv/app
		header Cache-Control "no-cache"
		rewrite * /index.html
		file_server
	}

	handle {
		redir * /console 302
	}
}
