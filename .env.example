# Local development only.
#
# Production takes no .env: the deploy workflow forwards GitHub secrets and
# variables to the host with the deploy command, and nothing is written there.
# See docs/deployment/production-credentials.md.
#
# Copy to .env and fill in. Everything omitted falls back to the default in
# app/core/config.py; only MODERATOR_BOT_TOKEN, ADMIN_SUPER_ADMINS and the
# DB credentials have none.

# ── Moderator Bot ──
MODERATOR_BOT_TOKEN=your_bot_token_here
# Tokens of retired bots (@student_cz_bot, @konnekt_moder_bot), comma-separated.
# Each answers every DM with the new address; one token alone is fine too.
# MODERATOR_BOT_RETIRED_TOKEN=
# Konnekt's media, each a file_id this bot received or an https URL.
# The video goes under the chat greeting and the note after the captcha, and
# with the photo into the /start album; the cover shows before it plays.
# Unset, text only.
# MODERATOR_BOT_INTRO_VIDEO=
# MODERATOR_BOT_INTRO_VIDEO_COVER=
# MODERATOR_BOT_INTRO_PHOTO=

# ── Ads contact desk (@konnekt_ads_bot) ──
# Off unless both are set: the bot's token and the staff forum supergroup it
# opens a topic per person in. The bot needs to be an admin there that can manage topics.
# ADS_BOT_TOKEN=
# ADS_BOT_GROUP_ID=
# Who /start and /contacts send advertisers and questions to (a username).
# Deployed from CATALOG_ADS_CONTACT, the same value as the site's ads pages.
# ADS_BOT_CONTACT=

# ── Admin ──
ADMIN_SUPER_ADMINS=123456789,987654321
ADMIN_REPORT_CHAT_ID=

# ── Database ──
DB_USER=postgres
DB_PASSWORD=your_password_here
# DB_HOST=db       # [Optional] default: db (docker service name)
# DB_PORT=5432     # [Optional]
DB_NAME=moderator_bot

# ── Application ──
APP_DEBUG=false
APP_ENVIRONMENT=development
APP_TIMEZONE=UTC

# ── Logging ──
LOG_LEVEL=INFO
# LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
# LOG_FILE_PATH=logs/bot.log
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5

# ── Ad detector (heuristic, no model) ──
MODERATION_AD_DETECTOR_ENABLED=true
MODERATION_AD_DETECTOR_WHITELIST=
MODERATION_AD_DETECTOR_SNIPPET_CHARS=200

# ── Join captcha ──
CAPTCHA_ANSWER_MINUTES=1440
# Under 5: Telegram lets the bot write to an applicant for five minutes.
CAPTCHA_REMIND_AFTER_MINUTES=4
# How long a tap on a chat's join button in the Mini App catalog skips its captcha; 0 turns it off.
CAPTCHA_CATALOG_PASS_HOURS=24
# Captcha in the chat: when somebody who opened the bot and did not answer is reminded.
CAPTCHA_IN_CHAT_REMIND_AFTER_MINUTES=10
# Captcha in the chat: the least time between two cards naming newcomers.
CAPTCHA_CARD_BATCH_SECONDS=60

# ── Telethon (Userbot) ──
TELETHON_API_ID=0
TELETHON_API_HASH=
# TELETHON_PHONE=+1234567890  # Required for first-time auth only

# ── Web admin UI ──
WEBAPI_PUBLIC_URL=https://localhost:5173
WEBAPI_SESSION_TTL_DAYS=30
WEBAPI_SESSION_COOKIE_SECURE=false   # true in production (HTTPS)

# ── MCP control plane (served by the bot process) ──
# The token is the switch: unset means no endpoint.
MCP_TOKEN=
# Optional. Confirmations go to the first super admin unless this names another.
# MCP_INITIATOR_ID=0
