---
import { Image } from 'astro:assets';

import { published } from '../articles/published.ts';
/**
 * Landing F in one language, rendered at build time: every word is in the
 * HTML, for search engines and for a phone that has not run a script yet.
 * The prototype (konnekt-video, accepted by Azamat in agora 10062) built the
 * same page in the browser from the same data (data.ts). Its first screen is
 * variant E (agora 11888): the title beside the newest articles, four to a
 * 2×2 block, and the chats across the width under both.
 */
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { t as copy, num as number, openLink, v as variant } from '../landing/copy.ts';
import { CHATS, STATS } from '../landing/data.ts';
import Base from '../layouts/Base.astro';
import { articlePath, type Lang, localePath, rubricTally } from '../paths.ts';
import { articleCount, longDate, TEXTS } from '../texts.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = (key: string) => copy(lang, key);
const v = (key: string) => variant(lang, key);
const num = (n: number) => number(lang, n);
// The articles in this language, newest first; the block is left out while
// there are none. Four fill it; with fewer, the last cell is all of them.
const all = await published(lang);
const articles = all.slice(0, 4);
const rubrics = rubricTally(all.map((article) => ({ rubric: article.data.rubric })));
const arrow =
  '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';

// The chats' own avatars, emitted with hashed names.
const files = import.meta.glob<string>('../landing/av/*.{jpg,svg}', {
  eager: true,
  query: '?url',
  import: 'default',
});
const avatar = (name: string) => {
  const url = files[`../landing/av/${name}`];
  if (!url) throw new Error(`no avatar ${name}`);
  return url;
};
---

<Base lang={lang} path="/" title={t('meta.title')} description={t('hero.subShort')}>
  <Header lang={lang} />
<main>
  <div class={`wrap hero${articles.length > 0 ? "" : " solo"}`}>
    <div class="h-main">
      <h1>{t("hero.short")}</h1>
      <p class="lead">{t("hero.subShort")}</p>
      <div class="actions">
        <a class="btn" href={openLink("site_hero")}><span>{t("cta.open")}</span><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        <div class="later"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="13" rx="2"/><path d="M8 21h8"/></svg><span>{t("cta.note")}</span></div>
      </div>
    </div>
    {articles.length > 0 && (
      <section class="card ax" aria-label={t("nav.guides")}>
        <div class="ax-head"><span class="eyebrow"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h8l4 4v14H6zM14 3v4h4M9 12h6M9 16h6"/></svg><span>{t("nav.guides")}</span></span><a class="ax-all" href={localePath(lang, "/articles/")}><span>{t("guides.all")}</span><Fragment set:html={arrow} /></a></div>
        <div class="ax-list">
          {articles.map((article, i) => (
            <a class="ax-i" href={articlePath(article.id)}>
              {i === 0 && article.data.cover && (
                <Image
                  class="ax-img"
                  src={article.data.cover}
                  alt=""
                  widths={[400, 800, 1200]}
                  sizes="(min-width: 1040px) min(30vw, 352px), (min-width: 720px) 45vw, 100vw"
                  loading="eager"
                  decoding="async"
                  style={`object-position: ${Math.round((article.data.coverFocus ?? 0.5) * 100)}% 50%`}
                />
              )}
              <small class="ax-meta"><span class="ax-tag">{TEXTS[lang].rubrics[article.data.rubric]}</span><span>{longDate(lang, article.data.published)}</span></small>
              <h3 class="ax-t">{article.data.title}</h3>
              <p class="ax-d">{article.data.description}</p>
              <span class="ax-go" aria-hidden="true"><Fragment set:html={arrow} /></span>
            </a>
          ))}
          {articles.length < 4 && (
            <a class={`ax-i ax-more${articles.length === 2 ? " wide" : ""}`} href={localePath(lang, "/articles/")}>
              <small class="ax-meta"><span>{articleCount(lang, all.length)}</span></small>
              <b>{t("guides.all")}</b>
              <span class="ax-rubs">{rubrics.map(([rubric, n]) => <span><span>{TEXTS[lang].rubrics[rubric]}</span><b>{num(n)}</b></span>)}</span>
              <span class="ax-go" aria-hidden="true"><Fragment set:html={arrow} /></span>
            </a>
          )}
        </div>
      </section>
    )}
    <div class="card h-chats wash3" id="chats">
      <span class="eyebrow"><svg viewBox="0 0 24 24"><path d="M4 12a8 7 0 1 1 3.5 5.8L4 19l1-3.2A6.6 6.6 0 0 1 4 12z"/></svg><span>{t("nav.chats")}</span></span>
      <h3>{t("chats.title")}</h3>
      <div class="cs"><span><b>{num(STATS.students)}</b> {t("stats.students")}</span><span><b>{num(STATS.chats)}</b> {t("stats.chats")}</span></div>
      <div class="rows" id="rows">{CHATS.map((x) => <div class="row"><img class="av" src={avatar(`${x.av}.jpg`)} alt="" width="40" height="40" loading="lazy" /><span class="rt"><b>{x.title}</b><small>{x.city}</small></span><span class="n"><i></i>{num(x.members)}</span></div>)}</div>
      <a class="all" href={openLink("site_chats")}><span>{v("allChats")}</span><Fragment set:html={arrow} /></a>
    </div>
  </div>

  <div class="wrap" id="help">
    <div class="bento">
      <div class="card c-help wash3">
        <span class="eyebrow"><svg viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6zM14 3v4h4M9 12h6M9 16h6"/></svg><span>{t("nav.help")}</span></span>
        <h3>{t("help.title")}</h3>
        <p>{t("help.text")}</p>
        <div class="helps">
          <div><span class="ic tone3"><svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/></svg></span><b>{v("ins")}</b><small>{v("insT")}</small></div>
          <div><span class="ic tone5"><svg viewBox="0 0 24 24"><path d="M6 3h8l4 4v14H6zM14 3v4h4"/></svg></span><b>{v("docs")}</b><small>{v("docsT")}</small></div>
          <div><span class="ic tone0"><svg viewBox="0 0 24 24"><path d="M4 11l8-7 8 7v9H4z"/><path d="M10 20v-5h4v5"/></svg></span><b>{v("home")}</b><small>{v("homeT")}</small></div>
          <div><span class="ic tone2"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="12" r="2.2"/><path d="M14 10.5h4M14 13.5h3"/></svg></span><b>{v("visa")}</b><small>{v("visaT")}</small></div>
        </div>
      </div>
      <div class="card c-cities stat wash0"><b>{num(STATS.cities)}</b><span>{v("citiesT")}</span>
        <ul class="cities"><li>Praha</li><li>Brno</li><li>Pardubice</li><li>České Budějovice</li><li>Ostrava</li><li>Plzeň</li><li>Olomouc</li></ul></div>
    </div>
    <p class="note">{t("stats.note")}</p>
  </div>

  <section class="wrap" id="how">
    <div class="sec-head"><h2>{t("how.title")}</h2></div>
    <div class="steps">
      <div class="step"><span class="n tone3">1</span><div><h3>{t("how.1.title")}</h3><p>{t("how.1.text")}</p></div></div>
      <div class="step"><span class="n tone2">2</span><div><h3>{t("how.2.title")}</h3><p>{t("how.2.text")}</p></div></div>
      <div class="step"><span class="n tone0">3</span><div><h3>{t("how.3.title")}</h3><p>{t("how.3.text")}</p></div></div>
    </div>
  </section>

  <div class="wrap">
    <div class="offer" id="offer">
      <div>
        <h2>{t("offer.title")}</h2>
        <p>{t("offer.text")}</p>
        <a class="ghost" href={openLink("site_offer")}>{t("offer.cta")}</a>
      </div>
      <div class="request" aria-hidden="true">
        <div class="head"><i></i><span>{v("reqHead")}</span></div>
        <div class="topic"><span>{v("reqSample")}</span> · <span>{t("app.subject1")}</span></div>
        <q>{v("reqText")}</q>
      </div>
    </div>
  </div>

  <section class="wrap">
    <div class="final">
      <h2>{t("final.title")}</h2>
      <p>{t("final.text")}</p>
      <div class="actions">
        <a class="btn" href={openLink("site_final")}><span>{t("cta.open")}</span><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        <div class="later">{t("cta.note")}</div>
      </div>
    </div>
  </section>
</main>
  <Footer lang={lang} />
</Base>

<script>
  // The link of the section being read is marked in both navs, as in the
  // prototype. Sections that share a row on wide screens let a click pick.
  const head = document.querySelector<HTMLElement>('.top');
  const links = document.querySelectorAll<HTMLAnchorElement>('.nav a, .subnav a, .menu-panel a');
  // «offer» is no menu item, but reaching it ends «how»'s mark.
  const ids = ['chats', 'help', 'how', 'offer'];
  let picked: string | null = null;
  let current: string | null | undefined;
  const mark = (id: string | null) => {
    for (const a of links) {
      if (!a.hash) continue; // a section of its own (the articles), not a part of this page
      if (a.hash === `#${id}`) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    }
    const chip = document.querySelector<HTMLAnchorElement>(`.subnav a[href$="#${id}"]`);
    const bar = chip?.parentElement;
    if (chip && bar && bar.scrollWidth > bar.clientWidth) {
      bar.scrollTo({
        left: chip.offsetLeft - bar.offsetLeft - (bar.clientWidth - chip.offsetWidth) / 2,
        behavior: 'smooth',
      });
    }
  };
  const spy = () => {
    if (!head) return;
    const line = head.offsetHeight + innerHeight * 0.3;
    let top = Number.NEGATIVE_INFINITY;
    let row: string[] = [];
    for (const id of ids) {
      const box = document.getElementById(id)?.getBoundingClientRect();
      // Marked only while the reading line is inside it, or in the gap of up to
      // 32px before the next section; past that, nothing.
      if (!box || box.top > line || box.bottom + 32 <= line) continue;
      const y = Math.round(box.top);
      if (y > top) {
        top = y;
        row = [id];
      } else if (y === top) row.push(id);
    }
    let id = row.length ? (picked && row.includes(picked) ? picked : (row[0] ?? null)) : null;
    // A clicked short section keeps its mark while it is still at the top.
    const py = picked ? document.getElementById(picked)?.getBoundingClientRect().top : undefined;
    if (picked && py !== undefined && py >= head.offsetHeight - 8 && py <= line) id = picked;
    if (id !== current) {
      current = id;
      mark(id);
    }
  };
  for (const a of links) a.addEventListener('click', () => (picked = a.hash.slice(1)));
  addEventListener('scroll', spy, { passive: true });
  addEventListener('resize', spy);
  spy();
</script>
