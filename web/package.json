{
  "name": "@konnekt/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "dev:site": "astro dev --root site",
    "build": "tsc -b && vite build && astro build --root site",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "node scripts/test.mjs",
    "check:scroll": "node scripts/check-scroll.mjs",
    "check:devices": "node scripts/check-devices.mjs",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile",
    "api:generate": "openapi-ts"
  },
  "dependencies": {
    "@lingui/core": "^6.10.0",
    "@lingui/react": "^6.10.0",
    "@sentry/react": "^11.10.0",
    "@tanstack/react-query": "^5.104.4",
    "@tma.js/sdk-react": "^3.0.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@astrojs/node": "11.1.8",
    "@astrojs/sitemap": "3.7.4",
    "@biomejs/biome": "^2.5.15",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "@lingui/babel-plugin-lingui-macro": "^6.10.0",
    "@lingui/cli": "^6.10.0",
    "@lingui/conf": "^6.10.0",
    "@lingui/format-po": "^6.10.0",
    "@lingui/vite-plugin": "^6.10.0",
    "@sentry/vite-plugin": "^11.10.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "astro": "7.4.0",
    "eruda": "^3.4.3",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-mkcert": "^2.1.0",
    "yaml": "2.9.1"
  }
}
