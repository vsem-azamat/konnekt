# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
# Telethon sessions are signed-in accounts; the scripts keep theirs under .creds/
*.session
*.session-journal
PROJECT_TRACKING.md
logs/
# Deliberate allowlist: scratch scripts stay local, real ones are named. A new
# script added here is silently ignored by `git add -A` until it is listed.
scripts/*
!scripts/wait_for_postgres.sh
!scripts/entrypoint.sh
!scripts/admin_host.sh
!scripts/env_to_github.sh
!scripts/restore_drill.sh
!scripts/tested_lanes.sh
!scripts/tg_accounts.py
!scripts/tg_chats.py
!scripts/tg_promote.py
!scripts/tg_add_bot.py
!scripts/tg_prehistory.py
.claude/

# Local credential drops — never tracked.
.creds/

# The retired Svelte console: a checkout from before it keeps its ignored
# dependencies there, which must not reappear as untracked files.
/webui/
