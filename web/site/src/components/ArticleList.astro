---
/** The articles in one language. */
import { getCollection } from 'astro:content';

import { entry } from '../articles/entries.ts';
import '../site.css';
import Base from '../layouts/Base.astro';
import { hiddenPaths, type Lang, langOf, localePath } from '../paths.ts';
import { TEXTS } from '../texts.ts';
import ArticleCards from './ArticleCards.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = TEXTS[lang];
const all = await getCollection('articles');
const articles = all.filter((article) => langOf(article.id) === lang);
const hidden = hiddenPaths(
  all.map(({ id, data }) => ({
    id,
    draft: data.draft,
    translationKey: data.translationKey,
  })),
);
---

<Base
  lang={lang}
  path="/articles/"
  title={`${t.articles} — Konnekt`}
  description={t.articles}
  noindex={hidden.includes(localePath(lang, '/articles/'))}
>
  <Header lang={lang} path="/articles/" />
  <main class="page">
    <nav class="crumbs" aria-label="breadcrumbs">
      <a href={localePath(lang, '/')}>Konnekt</a>
    </nav>
    <h1>{t.articles}</h1>
    {articles.length === 0 && <p>{t.noArticles}</p>}
    <ArticleCards lang={lang} articles={articles} />
  </main>
  <Footer lang={lang} path="/articles/" />
</Base>
