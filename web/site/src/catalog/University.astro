---
/**
 * A university's page: its chats by heading, each an anchor rather than a page
 * of its own, the way into the app on this university's chats, and its
 * neighbours in the same city. Tutors join it with (c): real ones, with
 * consent, filtered by university.
 */
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { num } from '../landing/copy.ts';
import Base from '../layouts/Base.astro';
import { localePath } from '../paths.ts';
import ChatRow from './ChatRow.astro';
import { anchors, indexable, mainChat, sections } from './catalog.ts';
import './catalog.css';
import type { UniversityProps } from './load.ts';
import { toneOf } from './page.ts';
import { CATALOG_TEXTS, count, noun } from './texts.ts';

type Props = UniversityProps;

const { lang, entry, neighbours } = Astro.props;
const t = CATALOG_TEXTS[lang];
const { university: u, chats } = entry;
const short = u.short_name ?? u.name;
const path = `/universities/${u.code}/`;
const thin = !indexable(entry);
const main = mainChat(chats);
const ids = anchors(chats);
const site = Astro.site?.href ?? '/';
const page = new URL(localePath(lang, path), site).href;
const home = new URL(localePath(lang, '/'), site).href;
const list = new URL(localePath(lang, '/universities/'), site).href;
const open = `/api/v1/open?start=uni-${u.code}`;

// What search engines read of the page: a collection about the university,
// its chats as a list, and the way here.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': page,
      url: page,
      name: t.universityH1(short),
      inLanguage: lang,
      about: {
        '@type': 'CollegeOrUniversity',
        name: u.name,
        ...(u.short_name ? { alternateName: u.short_name } : {}),
        ...(u.site_url ? { url: u.site_url } : {}),
        ...(u.city
          ? {
              address: {
                '@type': 'PostalAddress',
                addressLocality: u.city,
                addressCountry: 'CZ',
              },
            }
          : {}),
      },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: chats.length,
        itemListElement: chats.map((chat, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: chat.title,
          url: `${page}#${ids.get(chat)}`,
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t.home, item: home },
        { '@type': 'ListItem', position: 2, name: t.topics.university, item: list },
        { '@type': 'ListItem', position: 3, name: short, item: page },
      ],
    },
  ],
};
---

<Base
  lang={lang}
  path={path}
  title={t.universityTitle(short)}
  description={t.universityDescription(count(lang, chats.length, t.chats), short, u.name)}
  noindex={thin}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Header lang={lang} path={path} />
  <main class="wrap cat">
    <ol class="crumbs" aria-label={t.nav}>
      <li><a href={localePath(lang, '/')}>{t.home}</a></li>
      <li><a href={localePath(lang, '/universities/')}>{t.topics.university}</a></li>
      <li aria-current="page">{short}</li>
    </ol>

    <div class={`card cat-hero with-side wash${toneOf(u.code) % 4}`}>
      <div class="cat-hero">
        <h1>{t.universityH1(short)}</h1>
        <p class="facts">{u.name}{u.city && <Fragment>&nbsp;· <span>{u.city}{u.site_url && <Fragment>&nbsp;·</Fragment>}</span></Fragment>}{u.site_url && <Fragment> <span><a href={u.site_url} rel="nofollow">{u.site_url.replace(/^https:\/\/(www\.)?/, '').replace(/\/$/, '')}</a></span></Fragment>}</p>
        <div class="nums">
          <div><b>{num(lang, chats.length)}</b><span>{noun(lang, chats.length, t.chats)} {t.inCatalog}</span></div>
          {main?.member_count != null && <div><b>{num(lang, main.member_count)}</b><span>{noun(lang, main.member_count, t.members)} {t.inMain}</span></div>}
        </div>
      </div>
      <div class="actions">
        <a class="btn" href={open}><span>{t.open}</span><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        <div class="later">{thin ? t.free : t.freeFaculty}</div>
      </div>
    </div>

    {
      sections(chats).map(({ topic, chats: here }) => (
        <section class="sec" aria-labelledby={`s-${topic}`}>
          <header>
            <h2 id={`s-${topic}`}>{t.pageTopics[topic]}</h2>
            <span class="count">{count(lang, here.length, t.chats)}</span>
          </header>
          <div class="rows">
            {here.map((chat) => <ChatRow lang={lang} chat={chat} id={ids.get(chat)} note={chat === main ? t.main : null} />)}
          </div>
        </section>
      ))
    }

    {
      thin && (
        <div class="card thin sec">
          <h3>{t.thinTitle}</h3>
          <p>{t.thinText(short)}</p>
          <a class="all" href="/api/v1/open?app=1"><span>{t.suggest}</span><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
      )
    }

    {
      neighbours.length > 0 && u.city && (
        <section class="sec" aria-labelledby="s-near">
          <header>
            <h2 id="s-near">{t.neighbours(u.city)}</h2>
          </header>
          <div class="rows">
            {neighbours.map(({ university: n, chats: theirs }) => {
              const name = n.short_name ?? n.name;
              return (
                <a class="row" href={localePath(lang, `/universities/${n.code}/`)}>
                  <span class={`mono small tone${toneOf(n.code)}`} data-long={name.length > 4 || undefined} aria-hidden="true">{name}</span>
                  <span class="rt"><b>{n.name}</b><small>{count(lang, theirs.length, t.chats)}</small></span>
                </a>
              );
            })}
          </div>
        </section>
      )
    }

    <p class="note">{t.note}</p>
  </main>
  <Footer lang={lang} path={path} />
</Base>
